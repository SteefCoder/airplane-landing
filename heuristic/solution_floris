import pandas as pd

small_data_set = r"C:\Users\flori\OneDrive\Desktop\Downloads\Data assignment aircraft landing 2 Small (2).xlsx"
large_data_set = r"C:\Users\flori\OneDrive\Desktop\Downloads\Data assignment aircraft landing 2 Large (2).xlsx"

def read_data(data: str) -> tuple[pd.DataFrame, int, int]:
    """
    Reads the data and returns it sorted from earliest to latest landing time.
    Also returns the number of aircrafts and the separation time
    """
    
    df_rough = pd.read_excel(data, sheet_name="Times per aircraft")
    df = df_rough.sort_values(by="Target landing time", ascending=True).reset_index(drop=True)
    info = pd.read_excel(data, sheet_name="General information", header=None)
    
    aircrafts = info.iloc[0, 1]
    separation = info.iloc[1, 1]
    
    return df, aircrafts, separation

def scheduling_algorithm(df: pd.DataFrame, aircrafts: int,separation: int):
    """
    The greedy algorithm for creating a landing schedule. It gives each 
    aircraft their target landing time, and if it is too close to the previous 
    flight, it delays the landing until there is 15 seconds between them.
    """
    
    schedule = []
    error = []
    
    for i in range(aircrafts):
        target = df.loc[i, "Target landing time"]
        
        if i == 0:
            time = int(target)
            error_i = 0
        else:
            previous = schedule[i - 1]
            time = int(max(target, previous + separation))
            error_i = time - target
        
        schedule.append(time)
        error.append(error_i)
    
    df["Scheduled landing time"] = schedule
    df["Error"] = error
    
    total_error = sum(error)
    
    return df, total_error

def main():
    """
    Runs the main program
    """
    df, aircrafts, separation = read_data(large_data_set)
    df, E = scheduling_algorithm(df, aircrafts, separation)
    
    print(df)
    print(f"The total error is: {E}")

if __name__ == '__main__':
    main()
